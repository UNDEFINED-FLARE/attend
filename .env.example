# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of this deployment (used in email confirmation and password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used by the Next.js app. Only for Supabase Edge Functions (set with `supabase secrets set`):
# PAYFAST_MERCHANT_ID=
# PAYFAST_PASSPHRASE=
# PAYSTACK_SECRET_KEY=

# Phone notifications (Web Push). Generate keys once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-institution.ac.za
# Shared with the database: select uniattend.set_push_secret('<same value>');  (at least 32 characters)
PUSH_DISPATCH_SECRET=

# Optional: walking directions for "Find my class" (server-only, never NEXT_PUBLIC_).
# Free key from https://openrouteservice.org/dev/#/signup . Without it, directions
# fall back to a straight line with a compass heading.
# ORS_API_KEY=

# Optional: bot protection on sign-up, sign-in and password reset (Cloudflare Turnstile).
# Set this first, redeploy, THEN turn on CAPTCHA (Turnstile + secret) in
# Supabase → Authentication → Attack protection. See src/components/captcha.tsx.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: post server errors to a chat channel (Slack, Discord, Teams or Google Chat
# incoming-webhook URL). Server-only. See src/instrumentation.ts.
# ALERT_WEBHOOK_URL=

# Required before saving any connection credential (Moodle token, roster-link token).
# Encrypts them on the server (AES-256-GCM) before they reach the database. Server-only;
# keep it secret and don't change it, or every connection's token must be re-entered.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# INTEGRATION_ENCRYPTION_KEY=
