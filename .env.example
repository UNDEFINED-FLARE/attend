# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of this deployment (used in email confirmation and password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used by the Next.js app. Only for Supabase Edge Functions (set with `supabase secrets set`):
# PAYFAST_MERCHANT_ID=
# PAYFAST_PASSPHRASE=
# PAYSTACK_SECRET_KEY=
