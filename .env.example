# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of this deployment (used in email confirmation and password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used by the Next.js app. Only for Supabase Edge Functions (set with `supabase secrets set`):
# PAYFAST_MERCHANT_ID=
# PAYFAST_PASSPHRASE=
# PAYSTACK_SECRET_KEY=

# Phone notifications (Web Push). Generate keys once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-institution.ac.za
# Shared with the database: select uniattend.set_push_secret('<same value>');  (at least 32 characters)
PUSH_DISPATCH_SECRET=
