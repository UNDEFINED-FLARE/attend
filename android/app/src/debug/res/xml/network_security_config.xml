<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (never in a release): plain http is allowed so a test build can open a
     dev server on this PC (http://10.0.2.2:3000 from the emulator, or the PC's LAN address
     from a phone). Release builds use src/main/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
